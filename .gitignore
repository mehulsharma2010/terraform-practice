# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (if containing sensitive data)
# *.tfvars
# *.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan outputs
*.plan

# Provider plugin binaries (Terraform < 0.13 used to download here)
.terraformrc
terraform.rc
